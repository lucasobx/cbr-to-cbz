#!/bin/bash
set -euo pipefail

# Check dependencies
for cmd in unrar unzip zip 7z file; do
    command -v "$cmd" &>/dev/null || { echo "Missing dependency: $cmd"; exit 1; }
done

detect_type() {
    local file="$1"
    local type
    type=$(file --brief --mime-type "$file")

    [[ "$type" == "application/x-rar"* ]] && echo "rar" && return
    [[ "$type" == "application/zip"* ]]   && echo "zip" && return
    [[ "$type" == "application/x-7z-compressed"* ]] && echo "7z" && return

    # Fallback: magic bytes
    local magic
    magic=$(od -A n -N 4 -t x1 "$file" | tr -d ' \n')

    [[ "$magic" == "52617221"* ]] && echo "rar" && return
    [[ "$magic" == "504b"*     ]] && echo "zip" && return
    [[ "$magic" == "377abcaf"* ]] && echo "7z"  && return

    echo "unknown"
}

process() {
    local file="$1"
    local dir
    dir=$(dirname "$file")
    local name
    name=$(basename "$file" .cbr)
    local base="${dir}/${name}"
    local cbz="${base}.cbz"
    local type
    type=$(detect_type "$file")

    mkdir -p "$base"

    local extracted=false
    case "$type" in
        rar) unrar x -inul "$file" "$base/" && extracted=true ;;
        zip) unzip -qq    "$file" -d "$base/" && extracted=true ;;
        7z)  7z x "$file" -o"$base/" -bd -bso0 && extracted=true ;;
        *)
            echo "Error: unknown format for $file"
            rmdir "$base"
            return
            ;;
    esac

    if $extracted; then
        rm -f "$file"
        if 7z a -tzip -mmt="$(nproc)" "$cbz" "$base/" -bd -bso0 > /dev/null; then
            rm -rf "$base"
            echo "Done: $cbz"
        else
            echo "Error compressing: $file — folder kept: $base"
        fi
    else
        echo "Extraction error for: $file"
        rm -rf "$base"
    fi
}

export -f detect_type
export -f process

mapfile -d '' files < <(find . -name "*.cbr" -type f -print0)

if [[ ${#files[@]} -eq 0 ]]; then
    echo "No .cbr files found."
    exit 0
fi

echo "Found ${#files[@]} file(s). Starting conversion..."

N=$(nproc 2>/dev/null || echo 4)
printf '%s\0' "${files[@]}" | xargs -0 -P "$N" -I{} bash -c 'process "$@"' _ {}
