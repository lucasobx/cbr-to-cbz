#!/bin/bash
set -euo pipefail

# Check dependencies
for cmd in unrar unzip zip 7z file; do
    command -v "$cmd" &>/dev/null || { echo "Missing dependency: $cmd"; exit 1; }
done

detect_type() {
    local file="$1"
    local type
    type=$(file --brief --mime-type "$file")

    [[ "$type" == "application/x-rar"* ]] && echo "rar" && return
    [[ "$type" == "application/zip"* ]]   && echo "zip" && return
    [[ "$type" == "application/x-7z-compressed"* ]] && echo "7z" && return

    # Fallback: magic bytes
    local magic
    magic=$(od -A n -N 4 -t x1 "$file" | tr -d ' \n')

    [[ "$magic" == "52617221"* ]] && echo "rar" && return
    [[ "$magic" == "504b"*     ]] && echo "zip" && return
    [[ "$magic" == "377abcaf"* ]] && echo "7z"  && return

    echo "unknown"
}

process() {
    local file="$1"
    local dir
    dir=$(dirname "$file")
    local name
    name=$(basename "$file" .cbr)
    local cbz_final="${dir}/${name}.cbz"
    local type
    type=$(detect_type "$file")

    # Prefer /dev/shm (RAM) if available, otherwise /tmp (local disk)
    local tmproot
    if [[ -d /dev/shm && -w /dev/shm ]]; then
        tmproot=/dev/shm
    else
        tmproot=/tmp
    fi
    local tmpdir
    tmpdir=$(mktemp -d "${tmproot}/cbrtocbz.XXXXXX")

    local extracted=false
    case "$type" in
        rar) unrar x -inul "$file" "$tmpdir/" && extracted=true ;;
        zip) unzip -qq    "$file" -d "$tmpdir/" && extracted=true ;;
        7z)  7z x "$file" -o"$tmpdir/" -bd -bso0 && extracted=true ;;
        *)
            echo "Error: unknown format for $file"
            rm -rf "$tmpdir"
            return
            ;;
    esac

    if $extracted; then
        local cbz_tmp="${tmproot}/cbrtocbz_out_$$.cbz"
        if 7z a -tzip -mmt="$(nproc)" "$cbz_tmp" "$tmpdir/" -bd -bso0 > /dev/null; then
            rm -rf "$tmpdir"
            mv "$cbz_tmp" "$cbz_final"
            rm -f "$file"
            echo "Done: $cbz_final"
        else
            echo "Error compressing: $file"
            rm -rf "$tmpdir"
            rm -f "$cbz_tmp"
        fi
    else
        echo "Extraction error for: $file"
        rm -rf "$tmpdir"
    fi
}

export -f detect_type
export -f process

mapfile -d '' files < <(find . -name "*.cbr" -type f -print0)

if [[ ${#files[@]} -eq 0 ]]; then
    echo "No .cbr files found."
    exit 0
fi

echo "Found ${#files[@]} file(s). Starting conversion..."

N=$(nproc 2>/dev/null || echo 4)
printf '%s\0' "${files[@]}" | xargs -0 -P "$N" -I{} bash -c 'process "$@"' _ {}
